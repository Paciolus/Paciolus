{
  "name": "paciolus-frontend",
  "version": "2.1.0",
  "private": true,
  "overrides": {
    "postcss": "^8.5.8",
    "serialize-javascript": ">=7.0.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:types": "bash scripts/generate-types.sh",
    "prepare": "cd .. && husky frontend/.husky",
    "sprint:verify": "sh ../scripts/sprint_verify.sh"
  },
  "lint-staged": {
    "../backend/**/*.py": [
      "bash -c 'cd ../backend && ruff check --fix \"$@\"' --",
      "bash -c 'cd ../backend && ruff format \"$@\"' --"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "^11.9.0",
    "@testing-library/dom": "^10.4.2",
    "framer-motion": "^12.37.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.2"
  }
}
